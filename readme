```
ai-saas/
│
├── client/                          # React Frontend
│   ├── public/
│   └── src/
│       ├── components/
│       │   ├── Navbar.jsx
│       │   ├── Sidebar.jsx
│       │   ├── ToolCard.jsx
│       │   └── ResumeScore.jsx
│       ├── pages/
│       │   ├── Home.jsx
│       │   ├── Dashboard.jsx
│       │   ├── ArticleGenerator.jsx
│       │   ├── BlogTitleGenerator.jsx
│       │   ├── ImageGenerator.jsx
│       │   ├── BackgroundRemover.jsx
│       │   ├── ObjectRemover.jsx
│       │   └── ResumeAnalyzer.jsx
│       ├── services/                # Axios API calls
│       ├── context/                 # Global state
│       └── App.jsx
│
├── server/                          # Node.js + Express Backend
│   ├── config/
